# ============================================
# S3E System PRO — Variáveis de ambiente
# ============================================
# Desenvolvimento:  cp .env.example .env
# Docker dev (raiz): docker compose up --build   → exige `.env` (o compose usa env_file + interpolação).
# Produção: docker compose -f docker-compose.prod.yml --env-file .env up -d
# NUNCA commite .env com senhas reais.
# ============================================

# ============================================
# DEV EM DOCKER — docker-compose.yml (recomendado na tua máquina)
# ============================================
# Estes valores alinham com os defaults do compose (DB_* e Evolution na mesma rede).
# Se mudar DB_USER/DB_PASSWORD/DB_NAME aqui, o Postgres do compose usa os mesmos.
NODE_ENV=development

# Tag das imagens Docker Hub (backend + frontend) — local e produção devem usar a mesma
S3E_APP_VERSION=2.1.7

DB_USER=s3e_dev
DB_PASSWORD=dev_password_local
DB_NAME=s3e_dev
DB_PORT=5432

# Prisma / backend DENTRO do container (hostname do serviço = postgres)
DATABASE_URL=postgresql://s3e_dev:dev_password_local@postgres:5432/s3e_dev?schema=public&connection_limit=10

# Se correr o backend NO HOST (npm run dev) com Postgres no Docker, use localhost:
# DATABASE_URL=postgresql://s3e_dev:dev_password_local@localhost:5432/s3e_dev?schema=public&connection_limit=10

BACKEND_PORT=3001
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_PORT=5173
# Browser no teu PC fala com a API publicada em localhost:3001
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

JWT_SECRET=dev_jwt_altere_em_ambiente_real
JWT_EXPIRES_IN=7d

# Inclua as portas que o Vite usa no Docker (5173) e variações opcionais
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Criptografia (mín. 32 caracteres para AES-256 no backend)
ENCRYPTION_KEY=dev-docker-encryption-key-32chars!

# ============================================
# SMTP — contato (recuperação de senha, notificações)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ============================================
# SMTP — fiscal (NF-e / NFS-e por e-mail)
# ============================================
# Se vazio, o sistema pode reutilizar SMTP_* acima (conforme implementação).
SMTP_FISCAL_HOST=
SMTP_FISCAL_PORT=465
SMTP_FISCAL_SECURE=true
SMTP_FISCAL_USER=
SMTP_FISCAL_PASS=
SMTP_FISCAL_FROM=

# ============================================
# PUPPETEER (PDFs no backend)
# ============================================
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ============================================
# LET'S ENCRYPT (Traefik em docker-compose.prod.yml)
# ============================================
# E-mail usado pelo ACME (Let's Encrypt) no Traefik — só docker-compose.prod.yml (ignorado no compose dev).
ACME_EMAIL=admin@s3eengenharia.com.br

# ============================================
# WHATSAPP — Evolution API v2 ou Evolution Go (sem WAHA)
# ============================================
# No Docker o serviço chama-se `whatsapp-provider`. Dentro da rede: http://whatsapp-provider:8080
WHATSAPP_PROVIDER_BASE_URL=http://whatsapp-provider:8080
# evolution = Evolution API v2 (dev local). evolution-go = imagem evoapicloud/evolution-go (produção recomendada).
WHATSAPP_PROVIDER_KIND=evolution
# Nome da instância (rotas /.../{instance} na v2; na Go continua sendo o identificador lógico da sessão).
WHATSAPP_PROVIDER_SESSION=default
# Só a Evolution API v2 (Node): valor do campo "integration" no POST /instance/create (Baileys = biblioteca WhatsApp daquela API).
# Evolution Go NÃO usa esta variável — o backend ignora ao criar instância em modo evolution-go (payload é outro).
# Podes manter o default; em produção com KIND=evolution-go não altera o comportamento.
WHATSAPP_PROVIDER_INTEGRATION=WHATSAPP-BAILEYS
#
# Chave global do provedor:
# - Evolution API v2: AUTHENTICATION_API_KEY no container = este valor.
# - Evolution Go: GLOBAL_API_KEY no container = WHATSAPP_PROVIDER_API_KEY (mesmo .env).
# Gere: openssl rand -hex 32. Evite `$` na chave (interpolação do Compose).
WHATSAPP_PROVIDER_API_KEY=s3e-dev-change-me
#
# Evolution Go apenas: token da instância (apikey por instância). Deve ser o MESMO token usado ao criar a instância
# (POST /instance/create com { "name", "token" }) e o que o backend envia nas rotas como apikey da instância.
# Se vazio, alguns fluxos podem usar só a chave global — alinhe com a documentação da sua tag da imagem.
WHATSAPP_PROVIDER_GO_INSTANCE_TOKEN=
#
# Confirmação de leitura (duas setinhas azuis): o CRM só chama markMessageAsRead ao ABRIR a conversa no painel.
#
# Produção com Traefik (sem porta no host para o provedor):
#   WHATSAPP_PROVIDER_DASHBOARD_PUBLIC_URL=https://evo.s3eengenharia.com.br/manager
# Dev local (compose dev publica porta):
WHATSAPP_PROVIDER_HTTP_PORT=3333
WHATSAPP_PROVIDER_DASHBOARD_PUBLIC_URL=http://localhost:3333/manager
VITE_WHATSAPP_PROVIDER_DASHBOARD_URL=http://localhost:3333/manager
WHATSAPP_PROVIDER_QRCODE_LIMIT=60
# `presence: composing` + `delay` no envio: a Evolution Go exibe "digitando…"
# para o destinatário durante `WHATSAPP_PROVIDER_SEND_DELAY_MS` ANTES de
# realmente entregar o texto/mídia. 1500ms = 1,5s, comportamento humanizado.
WHATSAPP_PROVIDER_SEND_PRESENCE=composing
WHATSAPP_PROVIDER_SEND_DELAY_MS=1500

# Fila/mutex global de envio (anti-ban). Serializa todos os envios de WhatsApp
# no processo Node para que 7 operadores clicando "Enviar" ao mesmo tempo virem
# uma única sequência humana. Veja backend/src/services/whatsappSendQueue.service.ts.
#  - JITTER MIN/MAX: pausa aleatória APÓS cada envio (não atrasa o operador,
#    apenas o próximo job da fila). Valores em milissegundos.
#  - LOCK_DISABLE=1 desativa a fila (debug/emergência). NÃO usar em produção.
#  - LOCK_TIMEOUT_MS: prazo máximo de espera na fila antes de falhar (2 min default).
#  - DEBUG=1 imprime no log o jitter aplicado por job.
WHATSAPP_SEND_JITTER_MS_MIN=2000
WHATSAPP_SEND_JITTER_MS_MAX=5000
WHATSAPP_SEND_LOCK_TIMEOUT_MS=120000
WHATSAPP_SEND_LOCK_DISABLE=
WHATSAPP_SEND_DEBUG=
WHATSAPP_PROVIDER_PUBLIC_URL=http://localhost:3333
WHATSAPP_MEDIA_ALLOWED_HOSTS=mmg.whatsapp.net
WHATSAPP_WEBHOOK_SECRET=
#
# Banco legado Evolution API v2 (script docker/postgres/02-evolution-database.sql). A Go usa evogo_auth / evogo_users.
EVOLUTION_DATABASE_NAME=evolution
EVOLUTION_DATABASE_CLIENT_NAME=s3e_evolution
EVOLUTION_GO_CLIENT_NAME=s3e
EVOLUTION_GO_WADEBUG=INFO
#
# Evolution presa em "connecting" — ver troubleshooting na documentação da imagem em uso.

# ============================================
# CERTIFICADOS (NF-e / referência local)
# ============================================
CERTIFICADOS_DIR=./data/certificados
NFE_CERT_PFX_PATH=
NFE_CERT_PFX_PASSWORD=

# ============================================
# NGINX (se usar stack com nginx separado)
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# PRODUÇÃO — docker-compose.prod.yml (Traefik + HTTPS + Evolution Go)
# =============================================================================
# O compose usa env_file: .env em postgres, whatsapp-provider, backend, traefik e pgadmin.
#
# OBRIGATÓRIAS:
#   DB_USER, DB_PASSWORD, DB_NAME
#   JWT_SECRET, JWT_EXPIRES_IN
#   ACME_EMAIL                    → Let's Encrypt (Traefik)
#   CORS_ORIGIN                   → ex.: https://app.s3eengenharia.com.br
#   FRONTEND_URL                  → https://app.s3eengenharia.com.br
#   BACKEND_URL                   → https://api.s3eengenharia.com.br
#   WHATSAPP_PROVIDER_API_KEY     → GLOBAL_API_KEY na Evolution Go (e header apikey nas rotas admin)
#   WHATSAPP_PROVIDER_GO_INSTANCE_TOKEN → token da instância (apikey da sessão), alinhado ao create da instância
#
# WHATSAPP / HTTPS:
#   WHATSAPP_PROVIDER_KIND=evolution-go
#   WHATSAPP_PROVIDER_DASHBOARD_PUBLIC_URL=https://evo.s3eengenharia.com.br/manager
#   Traefik expõe só 80/443; não publique portas do backend/front/postgres na internet.
#
# ANTES DO PRIMEIRO UP:
#   chmod 600 traefik/acme.json
#   Crie volumes externos Docker (nomes abaixo) se ainda não existirem.
#
# IMAGEM DO FRONTEND (Vite):
#   VITE_API_URL e outras VITE_* são embutidas no build. Rebuild/push da imagem s3e-frontend sempre que mudar a URL da API:
#   docker build --build-arg VITE_API_URL=https://api.s3eengenharia.com.br ...
#
# VOLUMES EXTERNOS (exemplos de nomes usados no compose prod):
#   apps_postgres_data
#   apps_backend_uploads
#   apps_backend_logs
#   apps_backend_certificados
#
# Volumes locais criados pelo próprio compose (não precisam existir antes): evolution_go_dbdata, evolution_go_logs, redis_data, pgadmin_data.
#
# Redis (redis:7-alpine) está no stack para uso futuro / cache; a Evolution Go 0.7.x do compose usa Postgres para persistência.
#
# Comando típico no servidor:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================
