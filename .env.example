# ============================================
# S3E System PRO — Variáveis de ambiente
# ============================================
# Desenvolvimento:  cp .env.example .env
# Produção (TrueNAS / servidor): copie as seções necessárias para o .env usado pelo
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# NUNCA commite .env com senhas reais.
# ============================================

# ============================================
# DESENVOLVIMENTO LOCAL (docker-compose.yml)
# ============================================
NODE_ENV=development

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
# Usado por postgres + montagem de DATABASE_URL no backend (prod e dev).
DB_USER=s3e_user
DB_PASSWORD=ALTERE_SENHA_FORTE
DB_NAME=s3e_db
DB_PORT=5432

# Prisma (dev local). No docker-compose.prod.yml a URL é montada automaticamente no serviço backend.
DATABASE_URL=postgresql://s3e_user:ALTERE_SENHA_FORTE@postgres:5432/s3e_db?schema=public&connection_limit=10

# ============================================
# BACKEND
# ============================================
BACKEND_PORT=3001
PORT=3001
# URL pública/base do backend (CORS, links em e-mails, webhooks visíveis de fora).
# Dev: http://localhost:3001
# Prod atrás de proxy: https://api.seudominio.com
BACKEND_URL=http://localhost:3001

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ============================================
# JWT
# ============================================
JWT_SECRET=ALTERE_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
# Origens permitidas (separadas por vírgula). Em produção inclua a URL do front (ex.: https://app.seudominio.com).
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ============================================
# PGADMIN (opcional — exposto no compose prod na porta 5050)
# ============================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=ALTERE_SENHA_PGADMIN
PGADMIN_PORT=5050

# ============================================
# SMTP — contato (recuperação de senha, notificações)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ============================================
# SMTP — fiscal (NF-e / NFS-e por e-mail)
# ============================================
# Se vazio, o sistema pode reutilizar SMTP_* acima (conforme implementação).
SMTP_FISCAL_HOST=
SMTP_FISCAL_PORT=465
SMTP_FISCAL_SECURE=true
SMTP_FISCAL_USER=
SMTP_FISCAL_PASS=
SMTP_FISCAL_FROM=

# ============================================
# PUPPETEER (PDFs no backend)
# ============================================
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ============================================
# WHATSAPP — apenas Evolution API v2 (sem WAHA)
# ============================================
# No Docker, o serviço chama-se `whatsapp-provider` (imagem atendai/evolution-api).
# Dentro da rede Docker o backend usa sempre: http://whatsapp-provider:8080
WHATSAPP_PROVIDER_BASE_URL=http://whatsapp-provider:8080
WHATSAPP_PROVIDER_KIND=evolution
# Nome da instância Evolution (rotas /.../{instance}).
WHATSAPP_PROVIDER_SESSION=default
# Integração ao criar instância (Evolution v2 / Baileys).
WHATSAPP_PROVIDER_INTEGRATION=WHATSAPP-BAILEYS
# OBRIGATÓRIO em produção: mesma chave que AUTHENTICATION_API_KEY do container Evolution.
# Gere: openssl rand -hex 32. Se vazio no compose dev, o default está em docker-compose.yml (AUTHENTICATION_API_KEY).
# IMPORTANTE: não use o caractere $ na chave — o Docker Compose lê o .env e pode falhar com
# "invalid interpolation format" em AUTHENTICATION_API_KEY (escape $$ se precisar literal).
WHATSAPP_PROVIDER_API_KEY=
#
# Confirmação de leitura (duas setinhas azuis): o CRM só chama markMessageAsRead na Evolution ao ABRIR a conversa
# no painel (não a cada mensagem/refetch). Se ainda marcar como lida sem abrir o CRM, verifique outro cliente
# ligado à mesma instância ou integrações (ex. Chatwoot) que possam chamar leitura via API.
#
# Rotas Evolution API v2 (doc: https://doc.evolution-api.com ):
# - NÃO existe GET /instance/init na v2 → 404 no navegador é esperado.
# - Criar instância: POST /instance/create  + header apikey + JSON body, ex.:
#   curl -s -X POST "http://localhost:3333/instance/create" -H "apikey: SUA_CHAVE" \
#     -H "Content-Type: application/json" \
#     -d '{"instanceName":"default","integration":"WHATSAPP-BAILEYS","qrcode":true}'
# - Listar: GET /instance/fetchInstances  + header apikey (abrir só a URL no Chrome dá 401 — falta o header).
# - QR / conectar: GET /instance/connect/default  + header apikey (use curl, Postman ou o Manager).
# - Manager (UI): http://localhost:3333/manager (ajuste a porta se WHATSAPP_PROVIDER_HTTP_PORT for outra).
# Banco PostgreSQL só para a Evolution (criado por docker/postgres/02-evolution-database.sql na 1ª subida do Postgres).
# Se o volume do Postgres já existia antes desse script: crie manualmente → CREATE DATABASE evolution;
EVOLUTION_DATABASE_NAME=evolution
EVOLUTION_DATABASE_CLIENT_NAME=s3e_evolution
# Porta no HOST para API + Manager (mapa para 8080 no container). TrueNAS: libere no firewall.
WHATSAPP_PROVIDER_HTTP_PORT=3333
# URL que usuários abrem no navegador para QR / manager (produção: IP ou domínio do servidor).
WHATSAPP_PROVIDER_DASHBOARD_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:3333/manager
# Build do frontend (dev). Em produção o valor costuma ser definido no build da imagem.
VITE_WHATSAPP_PROVIDER_DASHBOARD_URL=http://localhost:3333/manager
# Janela do QR na Evolution (valor recomendado: 60 para dar mais tempo de leitura).
WHATSAPP_PROVIDER_QRCODE_LIMIT=60
# Obrigatórios em algumas versões (ex.: v2.3.x): payload de envio exige presence+delay.
# presence: composing | paused | recording
WHATSAPP_PROVIDER_SEND_PRESENCE=composing
# delay em ms (inteiro >=0)
WHATSAPP_PROVIDER_SEND_DELAY_MS=1200
# Opcional: URL pública do provedor para resolver mídia (se aplicável à sua rede).
WHATSAPP_PROVIDER_PUBLIC_URL=
# Opcional: hosts HTTPS permitidos no media-proxy para mídia externa temporária (ex.: mmg.whatsapp.net).
# Separe por vírgula. Aceita wildcard de sufixo, ex.: *.whatsapp.net
WHATSAPP_MEDIA_ALLOWED_HOSTS=mmg.whatsapp.net
# Opcional: validação do webhook (header X-Webhook-Secret) no backend.
WHATSAPP_WEBHOOK_SECRET=
#
# Evolution presa em "connecting" (logs repetindo connection.update) — não é migration em loop.
# 1) docker compose up -d --force-recreate whatsapp-provider (compose usa shm 2gb + DNS 8.8.8.8).
# 2) Teste saída para a internet a partir do container:
#    docker exec s3e-whatsapp-provider-dev wget -qO- --timeout=15 https://web.whatsapp.com | head -c 80
# 3) WSL2/Docker Desktop: desative VPN/proxy; teste rede celular (hotspot); veja MTU em issues do Docker.
# 4) Limpe sessão em disco: volume whatsapp_provider_sessions_dev (ou pasta instances/default).
# 5) OBRIGATÓRIO se ainda ficar em "connecting": apagar a instância no Postgres da Evolution (o volume sozinho NÃO remove o registro).
#    Com a Evolution no ar (porta WHATSAPP_PROVIDER_HTTP_PORT, ex. 3333) e o MESMO valor de WHATSAPP_PROVIDER_API_KEY:
#    curl -s -X DELETE "http://localhost:3333/instance/delete/default" -H "apikey: COLE_AQUI_SUA_CHAVE"
#    Depois crie de novo no manager ou deixe o backend chamar /instance/create na primeira requisição.
# 6) Opcional: CONFIG_SESSION_PHONE_VERSION — ver issues Evolution API no GitHub.

# ============================================
# CERTIFICADOS (NF-e / referência local)
# ============================================
CERTIFICADOS_DIR=./data/certificados
NFE_CERT_PFX_PATH=
NFE_CERT_PFX_PASSWORD=

# ============================================
# NGINX (se usar stack com nginx separado)
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# PRODUÇÃO — docker-compose.prod.yml (TrueNAS Scale / servidor)
# =============================================================================
# O arquivo docker-compose.prod.yml usa env_file: .env em postgres, whatsapp-provider,
# backend e pgadmin. Crie um .env no mesmo diretório do compose com pelo menos:
#
# OBRIGATÓRIAS (sem isso o stack não sobe ou fica inseguro):
#   DB_USER              → usuário PostgreSQL
#   DB_PASSWORD          → senha forte do banco
#   DB_NAME              → nome do database
#   JWT_SECRET           → segredo longo e aleatório (não reutilize o exemplo)
#   JWT_EXPIRES_IN       → ex.: 7d
#   CORS_ORIGIN          → URL(s) do frontend em produção, ex.: https://app.suaempresa.com
#   FRONTEND_URL         → mesma base do app que o usuário acessa (ex.: https://app.suaempresa.com)
#   BACKEND_URL          → URL pública da API (ex.: https://api.suaempresa.com ou http://IP:3001)
#   WHATSAPP_PROVIDER_API_KEY → idêntica à ideia de "API key" da Evolution; repita no .env para o backend
#
# Evolution no mesmo compose já recebe AUTHENTICATION_API_KEY=${WHATSAPP_PROVIDER_API_KEY} — use o MESMO valor.
#
# RECOMENDADAS:
#   WHATSAPP_PROVIDER_DASHBOARD_PUBLIC_URL → ex.: http://IP_DO_TRUENAS:3333/manager (ou HTTPS se tiver proxy)
#   WHATSAPP_PROVIDER_HTTP_PORT            → porta no host (padrão 3333)
#   WHATSAPP_WEBHOOK_SECRET                → se quiser assinar webhooks (opcional)
#   SMTP_* / SMTP_FISCAL_*                 → e-mail funcional
#   PGADMIN_EMAIL / PGADMIN_PASSWORD      → se for usar o serviço pgadmin do compose
#
# VOLUMES EXTERNOS (crie no Docker/TrueNAS ANTES do primeiro up):
#   apps_postgres_data
#   apps_backend_uploads
#   apps_backend_logs
#   apps_backend_certificados
#   apps_whatsapp_provider_sessions
#
# Comando típico no servidor:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#
# Modelo completo comentado para copiar no servidor:
#   docker-compose.prod.env.example  →  copiar para .env na pasta do compose
#
# Frontend na imagem de produção: porta publicada 8080:80. Ajuste VITE_API_URL na BUILD da imagem
# se o browser precisar de URL absoluta da API; variáveis VITE_* não são injetadas pelo compose no frontend prod.
# =============================================================================
