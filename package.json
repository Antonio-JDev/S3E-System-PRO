{
  "name": "s3e-system-pro",
  "version": "1.0.0",
  "description": "Sistema profissional de gestão para engenharia elétrica",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "install:all": "npm install --workspaces",
    "format:md": "prettier --write \"**/*.md\" --ignore-path .prettierignore && markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/build/**\" --fix || true"
  },
  "keywords": [
    "s3e",
    "engenharia",
    "gestão",
    "erp"
  ],
  "author": "Antonio Junior",
  "license": "Proprietary",
  "dependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/node": "^24.10.1",
    "async-lock": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.552.0",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.3.1",
    "tiptap-extension-font-size": "^1.2.0",
    "tiptap-extension-resize-image": "^1.3.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "markdownlint-cli2": "^0.12.1",
    "prettier": "^3.8.1"
  }
}
